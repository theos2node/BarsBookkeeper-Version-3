BBK_DATA_DIR=./data
OPENCLAW_LOGIC_MODEL=gpt-5.4
OPENCLAW_LOGIC_REASONING_EFFORT=low
OPENCLAW_FAST_MODEL=gpt-5.4-mini
OPENCLAW_FAST_REASONING_EFFORT=low
# Optional local estimate overrides, USD per 1M tokens.
# Defaults use OpenAI API pricing checked on 2026-05-11:
# gpt-5.4 input $2.50 / output $15.00; gpt-5.4-mini input $0.75 / output $4.50.
# OPENCLAW_RATE_GPT_5_4_INPUT_PER_1M=2.5
# OPENCLAW_RATE_GPT_5_4_OUTPUT_PER_1M=15
# OPENCLAW_RATE_GPT_5_4_MINI_INPUT_PER_1M=0.75
# OPENCLAW_RATE_GPT_5_4_MINI_OUTPUT_PER_1M=4.5
TOAST_API_HOST=https://ws-api.toasttab.com
TOAST_AUTH_PATH=/authentication/v1/authentication/login
TOAST_SALES_PATH=/orders/v2/ordersBulk
TOAST_RESTAURANT_EXTERNAL_IDS=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_API_KEY=
