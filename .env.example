BBK_DATA_DIR=./data
# BBK_ENV_FILE=./.env
BBK_SKIP_MODEL_SMOKE=1
OPENCLAW_LOGIC_MODEL=gpt-5.4
OPENCLAW_LOGIC_REASONING_EFFORT=low
OPENCLAW_FAST_MODEL=gpt-5.4-mini
OPENCLAW_FAST_REASONING_EFFORT=low
OPENCLAW_USE_CODEX=0
# Optional local estimate overrides, USD per 1M tokens. No price is assumed
# when these are unset; configure the rates that apply to your account.
# OPENCLAW_RATE_GPT_5_4_INPUT_PER_1M=
# OPENCLAW_RATE_GPT_5_4_OUTPUT_PER_1M=
# OPENCLAW_RATE_GPT_5_4_MINI_INPUT_PER_1M=
# OPENCLAW_RATE_GPT_5_4_MINI_OUTPUT_PER_1M=
TOAST_API_HOST=https://ws-api.toasttab.com
TOAST_AUTH_PATH=/authentication/v1/authentication/login
TOAST_SALES_PATH=/orders/v2/ordersBulk
TOAST_RESTAURANT_EXTERNAL_IDS=
TOAST_CLIENT_ID=
# Supply secrets directly through the environment or point to a chmod 600 file.
TOAST_CLIENT_SECRET=
TOAST_CLIENT_SECRET_FILE=
TOAST_API_KEY=
TOAST_API_KEY_FILE=
